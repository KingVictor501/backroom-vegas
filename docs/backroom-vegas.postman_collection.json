{
  "info": {
    "name": "The Vegas Backroom API",
    "description": "Every API route. Run 'Login' first (Postman keeps the bv_session cookie). Server Actions (forms) are not in here; see docs/api-design.md.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "email",
      "value": "throwaway@example.com"
    },
    {
      "key": "password",
      "value": "ChangeMe123"
    },
    {
      "key": "slipId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login (sets cookie)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Run this first. Use a throwaway account on the dev database."
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/logout",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "logout"
              ]
            }
          }
        },
        {
          "name": "Database health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/health/db",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "health",
                "db"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Bet slips",
      "item": [
        {
          "name": "List my slips",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/betslips",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "betslips"
              ]
            }
          }
        },
        {
          "name": "Create slip",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/betslips",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "betslips"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman test slip\",\n  \"picks\": [\n    {\n      \"id\": \"401873022:spreads:KC\",\n      \"gameId\": \"401873022\",\n      \"league\": \"nfl\",\n      \"gameLabel\": \"KC @ SEA\",\n      \"gameStartsAt\": \"2026-10-26T00:20:00.000Z\",\n      \"marketKey\": \"spreads\",\n      \"marketCategory\": \"game-lines\",\n      \"marketLabel\": \"Spread\",\n      \"period\": \"full-game\",\n      \"participant\": {\n        \"kind\": \"team\",\n        \"id\": \"12\",\n        \"name\": \"Kansas City Chiefs\"\n      },\n      \"side\": \"away\",\n      \"line\": -2.5,\n      \"odds\": -110,\n      \"sportsbook\": \"hardrock\",\n      \"label\": \"Chiefs -2.5\",\n      \"addedAt\": \"2026-10-25T12:00:00.000Z\"\n    }\n  ],\n  \"wager\": 10\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
                  "pm.collectionVariables.set('slipId', j.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Get slip",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/betslips/{{slipId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "betslips",
                "{{slipId}}"
              ]
            }
          }
        },
        {
          "name": "Rename slip",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/betslips/{{slipId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "betslips",
                "{{slipId}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman renamed\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Change wager",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/betslips/{{slipId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "betslips",
                "{{slipId}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"wager\": 25\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Copy slip",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/betslips/{{slipId}}/copy",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "betslips",
                "{{slipId}}",
                "copy"
              ]
            }
          }
        },
        {
          "name": "Get active slip",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/betslips/active",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "betslips",
                "active"
              ]
            }
          }
        },
        {
          "name": "Set active slip",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/betslips/active",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "betslips",
                "active"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"slipId\": \"{{slipId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Clear active slip",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/betslips/active",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "betslips",
                "active"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"slipId\": null\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Delete slip",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/betslips/{{slipId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "betslips",
                "{{slipId}}"
              ]
            }
          }
        }
      ]
    },
    {
