    },
    {
      "name": "4 – Logged out",
      "item": [
        {
          "name": "Games without cookie",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/games",
            "description": "Expect 401 unauthorized. (This request sends no Cookie header.)"
          }
        }
      ]
    },
    {
      "name": "5 – CORS (add an Origin header)",
      "description": "Postman ignores CORS, so we pretend to be a website by sending an Origin header, then read the response headers.",
      "item": [
        {
          "name": "Allowed website",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Cookie",
                "value": "bv_session={{session_cookie}}",
                "description": "Your login cookie, copied from the browser (see collection description)."
              },
              {
                "key": "Origin",
                "value": "{{allowedOrigin}}"
              }
            ],
            "url": "{{baseUrl}}/api/teams",
            "description": "Expect 200 AND response header Access-Control-Allow-Origin: http://localhost:3000."
          }
        },
        {
          "name": "Unknown website",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Cookie",
                "value": "bv_session={{session_cookie}}",
                "description": "Your login cookie, copied from the browser (see collection description)."
              },
              {
                "key": "Origin",
                "value": "https://evil.example.com"
              }
            ],
            "url": "{{baseUrl}}/api/teams",
            "description": "Expect 403 forbidden and NO Access-Control-Allow-Origin header."
          }
        },
        {
          "name": "Preflight – allowed",
          "request": {
            "method": "OPTIONS",
            "header": [
              {
                "key": "Origin",
                "value": "{{allowedOrigin}}"
              },
              {
                "key": "Access-Control-Request-Method",
                "value": "GET"
              }
            ],
            "url": "{{baseUrl}}/api/teams",
            "description": "Expect 204 with Access-Control-Allow-Origin and Allow-Methods headers."
          }
        },
        {
          "name": "Preflight – unknown",
          "request": {
            "method": "OPTIONS",
            "header": [
              {
                "key": "Origin",
                "value": "https://evil.example.com"
              },
              {
                "key": "Access-Control-Request-Method",
                "value": "GET"
              }
            ],
            "url": "{{baseUrl}}/api/teams",
            "description": "Expect 403 forbidden."
          }
        }
      ]
    }
  ]
}