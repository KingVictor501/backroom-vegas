          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Cookie",
                "value": "bv_session={{session_cookie}}",
                "description": "Your login cookie, copied from the browser (see collection description)."
              }
            ],
            "url": "{{baseUrl}}/api/teams/999",
            "description": "Expect 404 not-found."
          }
        },
        {
          "name": "Fake team (injuries)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Cookie",
                "value": "bv_session={{session_cookie}}",
                "description": "Your login cookie, copied from the browser (see collection description)."
              }
            ],
            "url": "{{baseUrl}}/api/injuries?team=999",
            "description": "Expect 404 not-found."
          }
        },
        {
          "name": "Fake player ID",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Cookie",
                "value": "bv_session={{session_cookie}}",
                "description": "Your login cookie, copied from the browser (see collection description)."
              }
            ],
            "url": "{{baseUrl}}/api/players/999999999",
            "description": "Expect 404 \"We couldn't find that player.\""
          }
        },
        {
          "name": "Bad player ID (letters)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Cookie",
                "value": "bv_session={{session_cookie}}",
                "description": "Your login cookie, copied from the browser (see collection description)."
              }
            ],
            "url": "{{baseUrl}}/api/players/abc",
            "description": "Expect 404."
          }
        }
      ]
    },
    {
      "name": "3 – Bad input",
      "item": [
        {
          "name": "League turned off",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Cookie",
                "value": "bv_session={{session_cookie}}",
                "description": "Your login cookie, copied from the browser (see collection description)."
              }
            ],
            "url": "{{baseUrl}}/api/games?league=nba",
            "description": "Expect 400 invalid-input (league)."
          }
        },
        {
          "name": "Bad prop category",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Cookie",
                "value": "bv_session={{session_cookie}}",
                "description": "Your login cookie, copied from the browser (see collection description)."
              }
            ],
            "url": "{{baseUrl}}/api/games/401873022/props?category=kicking",
            "description": "Expect 400 invalid-input (category)."
          }
        },
        {
          "name": "Search too short",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Cookie",
