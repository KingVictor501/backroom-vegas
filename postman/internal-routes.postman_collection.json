{
  "info": {
    "name": "Vegas Backroom – App API (internal)",
    "description": "FILE: postman/internal-routes.postman_collection.json\nWHAT IT IS FOR: Tests for the app's OWN API routes (Section 6): games, one game, props, teams, injuries, news, search, players (Section 11B), plus logged-out, fake-ID, bad-input, and CORS checks.\nHOW TO USE: Import this file AND postman/internal-local.postman_environment.json, select the \"Vegas Backroom – App (local)\" environment, then paste your login cookie value into session_cookie (Current value only).\nHOW TO GET THE COOKIE: log in at http://localhost:3000, open DevTools (Cmd+Option+I) > Application > Cookies > http://localhost:3000, click bv_session, copy its Value. It lasts 7 days. Never paste it into a chat or commit it.\nWHO USES IT: You, for testing. The app does not read this file.\nWHY THIS NAME: .postman_collection.json is the ending Postman uses for collections (JSON can not hold comments, so this description is the file header).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1 – Works (logged in)",
      "item": [
        {
          "name": "Games this week",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Cookie",
                "value": "bv_session={{session_cookie}}",
                "description": "Your login cookie, copied from the browser (see collection description)."
              }
            ],
            "url": "{{baseUrl}}/api/games",
            "description": "Expect 200: sportsbook, games (each with lines), oddsUnavailable."
          }
        },
        {
          "name": "One game (KC @ SEA)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Cookie",
                "value": "bv_session={{session_cookie}}",
                "description": "Your login cookie, copied from the browser (see collection description)."
              }
            ],
            "url": "{{baseUrl}}/api/games/401873022",
            "description": "Expect 200: game (with winProbability and lines), teamStats."
          }
        },
        {
          "name": "Props – touchdowns",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Cookie",
                "value": "bv_session={{session_cookie}}",
                "description": "Your login cookie, copied from the browser (see collection description)."
              }
            ],
            "url": "{{baseUrl}}/api/games/401873022/props?category=touchdowns",
            "description": "Expect 200: sections TD Scorers, First TD Scorer, 2+ TDs, 1st Half TDs. About 4 credits the first time per hour."
          }
        },
        {
          "name": "Teams",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Cookie",
                "value": "bv_session={{session_cookie}}",
                "description": "Your login cookie, copied from the browser (see collection description)."
              }
            ],
            "url": "{{baseUrl}}/api/teams",
            "description": "Expect 200: array of 32 teams."
          }
        },
        {
          "name": "One team (Chiefs = 12)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Cookie",
                "value": "bv_session={{session_cookie}}",
                "description": "Your login cookie, copied from the browser (see collection description)."
              }
            ],
            "url": "{{baseUrl}}/api/teams/12",
            "description": "Expect 200: team, divisionStanding, seasonStats, recentResults, roster."
          }
        },
        {
          "name": "Injuries (Chiefs)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Cookie",
                "value": "bv_session={{session_cookie}}",
                "description": "Your login cookie, copied from the browser (see collection description)."
              }
            ],
            "url": "{{baseUrl}}/api/injuries?team=12",
            "description": "Expect 200: array of injuries."
          }
        },
        {
          "name": "News",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Cookie",
                "value": "bv_session={{session_cookie}}",
                "description": "Your login cookie, copied from the browser (see collection description)."
              }
            ],
            "url": "{{baseUrl}}/api/news?limit=5",
            "description": "Expect 200: array of 5 plain-text articles."
          }
        },
        {
          "name": "Search – team",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Cookie",
                "value": "bv_session={{session_cookie}}",
                "description": "Your login cookie, copied from the browser (see collection description)."
              }
            ],
            "url": "{{baseUrl}}/api/search?q=chiefs",
            "description": "Expect 200: a team result."
          }
        },
        {
          "name": "Search – player",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Cookie",
                "value": "bv_session={{session_cookie}}",
                "description": "Your login cookie, copied from the browser (see collection description)."
              }
            ],
            "url": "{{baseUrl}}/api/search?q=mahomes",
            "description": "Expect 200: a player result."
          }
        },
        {
          "name": "Player (Aaron Rodgers)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Cookie",
                "value": "bv_session={{session_cookie}}",
                "description": "Your login cookie, copied from the browser (see collection description)."
              }
            ],
            "url": "{{baseUrl}}/api/players/8439",
            "description": "Expect 200: player (name, photo, number, position, team, injuryStatus), seasonStats, recentGames (up to 10), last5Average, last10Average, nextGameId, news. Stats only, no props (costs no Odds API credits)."
          }
        }
      ]
    },
    {
      "name": "2 – Not found (fake IDs)",
      "item": [
        {
          "name": "Fake game",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Cookie",
                "value": "bv_session={{session_cookie}}",
                "description": "Your login cookie, copied from the browser (see collection description)."
              }
            ],
            "url": "{{baseUrl}}/api/games/999999999",
            "description": "Expect 404 not-found."
          }
        },
        {
          "name": "Fake game (props)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Cookie",
                "value": "bv_session={{session_cookie}}",
