{
  "info": {
    "name": "Login lockout (Section 4)",
    "description": "Proves the lockout: 5 wrong passwords, then 429 for 15 minutes, even with the right password, and the same for emails that have no account. Run with the Collection Runner (Run collection) in order, once. Use a THROWAWAY account on the dev database, because the real account is locked for 15 minutes afterward.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "realEmail",
      "value": "throwaway@example.com"
    },
    {
      "key": "realPassword",
      "value": "ChangeMe123"
    },
    {
      "key": "wrongPassword",
      "value": "definitely-wrong-1"
    },
    {
      "key": "fakeEmail",
      "value": "nobody-has-this@example.com"
    }
  ],
  "item": [
    {
      "name": "1. Real account",
      "item": [
        {
          "name": "Wrong password #1",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 401', function () { pm.response.to.have.status(401); });",
                  "pm.test('Never contains a password hash', function () { pm.expect(pm.response.text()).to.not.include('passwordHash'); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{realEmail}}\",\n  \"password\": \"{{wrongPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "description": "A wrong password. Counts as a failed try."
          }
        },
        {
          "name": "Wrong password #2",
          "event": [
            {
              "listen": "test",
              "script": {
