            "description": "A wrong password. Counts as a failed try."
          }
        },
        {
          "name": "Wrong password #6 (locked)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 429', function () { pm.response.to.have.status(429); });",
                  "pm.test('Never contains a password hash', function () { pm.expect(pm.response.text()).to.not.include('passwordHash'); });",
                  "pm.test('Has a Retry-After header', function () { pm.expect(pm.response.headers.has('Retry-After')).to.eql(true); });",
                  "pm.test('Message says to wait', function () { pm.expect(pm.response.json().error.message).to.include('Too many attempts'); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{realEmail}}\",\n  \"password\": \"{{wrongPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "description": "The 6th try. Now you are locked out for 15 minutes."
          }
        },
        {
          "name": "RIGHT password during lockout (still refused)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 429', function () { pm.response.to.have.status(429); });",
                  "pm.test('Never contains a password hash', function () { pm.expect(pm.response.text()).to.not.include('passwordHash'); });",
                  "pm.test('Has a Retry-After header', function () { pm.expect(pm.response.headers.has('Retry-After')).to.eql(true); });",
                  "pm.test('Message says to wait', function () { pm.expect(pm.response.json().error.message).to.include('Too many attempts'); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{realEmail}}\",\n  \"password\": \"{{realPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "description": "Even the correct password is refused while locked out."
          }
        }
