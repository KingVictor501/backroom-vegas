              "raw": "{\n  \"picks\": [\n    {\n      \"id\": \"401873022|spreads|full-game|team:12|away|-3\",\n      \"gameId\": \"401873022\",\n      \"league\": \"nfl\",\n      \"gameLabel\": \"KC @ SEA\",\n      \"gameStartsAt\": \"2026-10-26T00:20Z\",\n      \"marketKey\": \"spreads\",\n      \"marketCategory\": \"game-lines\",\n      \"marketLabel\": \"Spread\",\n      \"period\": \"full-game\",\n      \"participant\": {\n        \"kind\": \"team\",\n        \"id\": \"12\",\n        \"name\": \"Kansas City Chiefs\"\n      },\n      \"side\": \"away\",\n      \"line\": -3,\n      \"odds\": -110,\n      \"sportsbook\": \"hardrock\",\n      \"label\": \"Chiefs -3\",\n      \"addedAt\": \"2026-10-22T20:00:00Z\"\n    },\n    {\n      \"id\": \"401873022|player_pass_yds|full-game|player:3139477|over|274.5\",\n      \"gameId\": \"401873022\",\n      \"league\": \"nfl\",\n      \"gameLabel\": \"KC @ SEA\",\n      \"gameStartsAt\": \"2026-10-26T00:20Z\",\n      \"marketKey\": \"player_pass_yds\",\n      \"marketCategory\": \"player-props\",\n      \"marketLabel\": \"Passing Yards\",\n      \"period\": \"full-game\",\n      \"participant\": {\n        \"kind\": \"player\",\n        \"id\": \"3139477\",\n        \"name\": \"Patrick Mahomes\"\n      },\n      \"side\": \"over\",\n      \"line\": 274.5,\n      \"odds\": -115,\n      \"sportsbook\": \"hardrock\",\n      \"label\": \"Mahomes Over 274.5 Passing Yards\",\n      \"addedAt\": \"2026-10-22T20:00:00Z\"\n    }\n  ]\n}"
