{
  "info": {
    "name": "Vegas Backroom – External APIs",
    "description": "FILE: postman/external-apis.postman_collection.json\nWHAT IT IS FOR: Every outside-API request used to build The Vegas Backroom (Section 5): The Odds API (B) and ESPN (C).\nHOW TO USE: In Postman, Import this file, then select the \"Vegas Backroom – External APIs\" environment so {{odds_api_key}} is filled in. No real keys are stored in this file.\nWHO USES IT: You, for testing. The app does not read this file.\nWHY THIS NAME: .postman_collection.json is the ending Postman uses for exported collections (JSON can not hold comments, so this description is the file header).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "B – Odds API",
      "description": "Costs are Odds API credits. Every request needs {{odds_api_key}} from your environment. Look at the response Headers tab for x-requests-remaining.",
      "item": [
        {
          "name": "B1 – sports (0 credits)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "https://api.the-odds-api.com/v4/sports?apiKey={{odds_api_key}}",
            "description": "List of sports. Free."
          }
        },
        {
          "name": "B2 – NFL events (0 credits)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "https://api.the-odds-api.com/v4/sports/americanfootball_nfl/events?apiKey={{odds_api_key}}",
            "description": "Upcoming NFL games with Odds API IDs, full team names, kickoff times. Free."
          }
        },
        {
          "name": "B3 – NFL game lines, all books (3 credits)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "https://api.the-odds-api.com/v4/sports/americanfootball_nfl/odds?apiKey={{odds_api_key}}&bookmakers=hardrockbet,betmgm,williamhill_us&markets=h2h,spreads,totals&oddsFormat=american",
            "description": "Spread, total, winner for every game from Hard Rock, BetMGM, Caesars (williamhill_us)."
          }
        },
        {
          "name": "B4 – markets offered for one game (1 credit)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "https://api.the-odds-api.com/v4/sports/americanfootball_nfl/events/176d474ed8b2bbf1eb4d7e9c56b4bf22/markets?apiKey={{odds_api_key}}&bookmakers=hardrockbet,betmgm,williamhill_us",
            "description": "Which markets each book offers for KC @ SEA (10/25/2026). Replace the event ID for other games."
          }
        },
        {
          "name": "B5 – player props for one game (up to 3 credits)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "https://api.the-odds-api.com/v4/sports/americanfootball_nfl/events/176d474ed8b2bbf1eb4d7e9c56b4bf22/odds?apiKey={{odds_api_key}}&bookmakers=hardrockbet,betmgm,williamhill_us&markets=player_anytime_td,player_pass_yds,player_tds_over&oddsFormat=american",
            "description": "Anytime TD, passing yards, 2+ TDs for KC @ SEA."
          }
        },
        {
          "name": "B6 – halves and quarters for one game (up to 3 credits)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "https://api.the-odds-api.com/v4/sports/americanfootball_nfl/events/176d474ed8b2bbf1eb4d7e9c56b4bf22/odds?apiKey={{odds_api_key}}&bookmakers=hardrockbet,betmgm,williamhill_us&markets=spreads_h1,totals_h1,h2h_q1&oddsFormat=american",
            "description": "1st half spread and total, 1st quarter winner for KC @ SEA."
          }
        }
      ]
    },
    {
