# FILE: .env.example
# WHAT IT'S FOR: A list of every secret setting (environment variable) the app needs,
# with the NAMES only and no real values. It's safe to upload to GitHub, so anyone
# setting up the project knows what to fill in.
# HOW TO USE IT: Copy this file to a new file named .env.local and fill in your real
# values there. .env.local is never uploaded to GitHub (see .gitignore).
# WHY THIS NAME: Next.js reads files whose names start with ".env". The ".example"
# ending is a common way to mark "template, not real values". Next.js does not load it.
#
# None of these start with NEXT_PUBLIC_, so Next.js keeps them on the server and
# never sends them to the browser.

# ---------- Database (Section 1) ----------
# Your MongoDB Atlas connection string (Atlas > Connect > Drivers > Node.js), with your real password filled in.
MONGODB_URI=
# The name of the database inside your cluster. Atlas creates it automatically the first time we save something.
MONGODB_DB=backroom-vegas

# ---------- Logins (Section 4) ----------
# A long random secret used to sign login cookies so nobody can fake one. We'll generate it in Section 4.
AUTH_SECRET=

# ---------- App address and CORS (Section 1B and Section 6) ----------
# The app's own web address. http://localhost:3000 while building, your Vercel URL when it's live.
APP_URL=http://localhost:3000
# Websites allowed to call our API routes from a browser, separated by commas. Never use "*".
ALLOWED_ORIGINS=http://localhost:3000

# ---------- Outside APIs (Section 5) ----------
# Your RapidAPI key for the NFL Football API (RapidAPI > the API's page > "X-RapidAPI-Key").
RAPIDAPI_KEY=
# The NFL Football API's host name from RapidAPI (the "X-RapidAPI-Host" value). We'll confirm it in Postman.
RAPIDAPI_NFL_HOST=
# Your key from The Odds API (emailed to you when you sign up at the-odds-api.com).
ODDS_API_KEY=
